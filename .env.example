# Required for fresh RunPod E2E.
# Do not commit real credentials in .env.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Optional but recommended for Hugging Face model downloads, gated models,
# private adapters, or higher anonymous download limits.
HF_TOKEN=hf_xxx
# HUGGINGFACE_HUB_TOKEN can be used instead of HF_TOKEN.

# Optional runtime overrides.
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# On RunPod network volumes, a local-disk venv is much faster than /workspace/.venv.
# Leave unset for the default repo-local .venv.
# VENV_DIR=/root/agent-lightening-rl-grpo-venv

# Default benchmark set is four OpenML tasks.
# Format:
#   openml_id|dataset_key|task_id|target_column|primary_metric|secondary_metric|priority
# Use target_column=auto to let ingestion resolve the OpenML default target and
# expose it to Track A as the canonical "target" column.
OPENML_TASK_SPECS="31|openml_31_german_credit|mltask_openml_31_german_credit_baseline|auto|roc_auc|accuracy|10
44|openml_44_spambase|mltask_openml_44_spambase_baseline|auto|roc_auc|accuracy|20
1461|openml_1461_bank_marketing|mltask_openml_1461_bank_marketing_baseline|auto|roc_auc|accuracy|30
1489|openml_1489_phoneme|mltask_openml_1489_phoneme_baseline|auto|roc_auc|accuracy|40"

TASK_LIMIT=4
TRACKA_INITIAL_ROLLOUTS=4
TRAINER=trl_grpo
REWARD_MODE=hybrid
NUM_GENERATIONS=4
TRACKB_CHECKPOINT_DIR=checkpoints/trackb_trl_grpo_runpod
